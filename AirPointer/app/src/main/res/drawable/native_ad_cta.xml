<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined on purpose: the app's own primary buttons are filled coral, so the ad's button
     can't be mistaken for an app action. Ripple for press feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FF5752">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_surface_high" />
            <stroke android:width="1dp" android:color="@color/ad_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
